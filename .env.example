# Copy to .env and fill in. Never commit .env
VISION_PROVIDER=gemini        # gemini reads photos; mock returns fixed sample data for demos only
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash # Gemini model for photo scans
AI_TIMEOUT_SECONDS=45
MAX_IMAGE_BYTES=4194304
RATE_LIMIT_PER_MIN=10
TRUST_PROXY=0                 # set 1 when deployed behind Vercel / a reverse proxy
